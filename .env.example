# --- Core ---
NODE_ENV=development
LOG_LEVEL=info

# --- Database (PostgreSQL 16) ---
DATABASE_URL=postgresql://bagyo:bagyo@localhost:5432/bagyo?schema=public

# --- Redis 7 (cache, rate limits, BullMQ queues) ---
REDIS_URL=redis://localhost:6379

# --- API server ---
API_HOST=0.0.0.0
API_PORT=3000
# Comma-separated origins allowed for CORS on dashboard/key-management routes.
CORS_ORIGINS=http://localhost:5173

# --- Ingestion ---
# Honest User-Agent sent to PAGASA. Set your real contact URL.
SCRAPER_USER_AGENT=BagyoAPI/1.0 (+https://bagyo-api.example.com)
PAGASA_BULLETIN_URL=https://www.pagasa.dost.gov.ph/tropical-cyclone/severe-weather-bulletin
PAGASA_PDF_INDEX_URL=https://pubfiles.pagasa.dost.gov.ph/tamss/weather/bulletin/
PAGASA_RAINFALL_URL=https://www.pagasa.dost.gov.ph/regional-forecast/ncrprsd
# Set to false to disable live scraping entirely (demo/seed-only mode).
INGEST_ENABLED=true

# --- Security ---
# 32+ char secret used to derive HMACs for internal tokens (NOT webhook secrets).
APP_SECRET=change-me-to-a-random-32+-char-string!!

# --- RapidAPI marketplace (optional) ---
# Shared secret from your RapidAPI provider dashboard (Settings -> Proxy Secret).
# Leave unset unless the API is listed on RapidAPI.
# RAPIDAPI_PROXY_SECRET=
